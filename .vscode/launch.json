{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Koan",
			"type": "debugpy",
			"request": "launch",
			"module": "koans.testing",
			"console": "integratedTerminal",
			"args": [
				"discovery"
			]
		},
		{
			"name": "Koan: Folder",
			"type": "debugpy",
			"request": "launch",
			"module": "koans.testing",
			"console": "integratedTerminal",
			"args": [
				"identity",
				"C00"
			]
		},
		{
			"name": "Koan: Module",
			"type": "debugpy",
			"request": "launch",
			"module": "koans.testing",
			"console": "integratedTerminal",
			"args": [
				"identity",
				"C00.exercise_test"
			]
		},
		{
			"name": "Koan: Class",
			"type": "debugpy",
			"request": "launch",
			"module": "koans.testing",
			"console": "integratedTerminal",
			"args": [
				"identity",
				"C00.exercise_test.Testing"
			]
		},
		{
			"name": "Koan: Test",
			"type": "debugpy",
			"request": "launch",
			"module": "koans.testing",
			"console": "integratedTerminal",
			"args": [
				"identity",
				"C00.exercise_test.Testing.test_challenge_01"
			]
		},
		{
			"name": "Tool: Publish",
			"type": "debugpy",
			"request": "launch",
			"module": "tooling.publish",
			"console": "integratedTerminal",
			"args": [
				"${workspaceFolder}\\publish.json",
				"${workspaceFolder}\\_dist"
			]
		},
		{
			"name": "Tool: Notebook-File",
			"type": "debugpy",
			"request": "launch",
			"module": "tooling.notebooks",
			"console": "integratedTerminal",
			"args": [
				"${file}",
				"${fileDirname}\\koan.ipynb",
				"false"
			]
		},
		{
			"name": "Tool: Stage-Folder",
			"type": "debugpy",
			"request": "launch",
			"module": "tooling.stage",
			"console": "integratedTerminal",
			"args": [
				"${workspaceFolder}\\C01",
				"${workspaceFolder}\\_dist\\C01"
			]
		},
		{
			"name": "Tool: Stub-File",
			"type": "debugpy",
			"request": "launch",
			"module": "tooling.stub",
			"console": "integratedTerminal",
			"args": [
				"${fileDirname}\\solution.py",
				"${fileDirname}\\exercise.py"
			]
		}
	]
}
